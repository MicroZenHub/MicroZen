{
  "enabled": true,
  "name": "C# save: format + affected lint",
  "description": "When a C# source file in the .NET solution is saved, write Prettier formatting (Nx format covers non-code files) and run the affected lint target scoped to affected projects only. Keeps the working tree clean after edits to core/csharp without running the full repo gate.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["core/csharp/**/*.cs"]
  },
  "then": {
    "type": "runCommand",
    "command": "npx nx format:write && npx nx affected -t lint"
  }
}
