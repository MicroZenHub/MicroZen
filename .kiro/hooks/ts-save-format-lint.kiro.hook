{
  "enabled": true,
  "name": "TS save: format + affected lint",
  "description": "When a TypeScript/HTML/SCSS source file in the Angular dashboard is saved, write Prettier formatting and run the affected ESLint target so formatting and lint stay clean. Scoped to the TS stack and to affected projects only; does not run the .NET suite.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["core/ts/**/*.ts", "core/ts/**/*.html", "core/ts/**/*.scss"]
  },
  "then": {
    "type": "runCommand",
    "command": "npx nx format:write && npx nx affected -t lint"
  }
}
