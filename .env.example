# Example environment for the MicroZen local development stack.
#
# Copy this file to `.env` (which is gitignored) and adjust the values:
#   cp .env.example .env
#
# docker-compose.yml reads the POSTGRES_* variables below to start PostgreSQL.
# The MicroZen.Api process reads its configuration from the ASP.NET Core
# configuration system; environment variables use `__` (double underscore) to
# separate configuration sections (e.g. ConnectionStrings__MicroZenDb maps to
# ConnectionStrings:MicroZenDb). All values here are PLACEHOLDERS only - never
# commit real secrets.

# --- PostgreSQL (consumed by docker-compose.yml) ---
# Credentials and database for the Postgres container.
POSTGRES_USER=microzen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=MicroZenDb
# Host port mapped to the container's 5432. Change if 5432 is already in use.
POSTGRES_PORT=5432

# --- MicroZen.Api database connection ---
# The API connects via Npgsql using the connection string named "MicroZenDb"
# (static MicroZen.Data.Context.Variables.MicroZenConnectionString). Supply it
# as the ConnectionStrings__MicroZenDb environment variable. The Host/Port/
# Database/Username/Password below must match the POSTGRES_* values above.
ConnectionStrings__MicroZenDb=Host=localhost;Port=5432;Database=MicroZenDb;Username=microzen;Password=change-me

# --- OAuth2 / Cognito (consumed by AddMicroZenOAuth2 in Program.cs) ---
# AddMicroZenOAuth2(MicroZenProvider.Cognito, ...) binds the "MicroZen"
# configuration section to MicroZenAppConfig. These are the settings it reads;
# the per-user-pool Cognito client ids, secrets, region and user pool id are
# fetched at runtime from the MicroZen authority (gRPC) using the API key below,
# so they are not configured here.
#
# MicroZen__AuthorityUrl : URL of this app's MicroZen authority (gRPC endpoint).
#                          This is a SEPARATE MicroZen authority instance, not
#                          this API's own HTTPS port - point it at your authority
#                          host, not at localhost:7070.
# MicroZen__APIKey       : API key used to authenticate this app to the authority.
# MicroZen__Interval     : minutes between authority pings (optional, default 5).
MicroZen__AuthorityUrl=https://your-microzen-authority.example
MicroZen__APIKey=replace-with-your-microzen-api-key
MicroZen__Interval=5
