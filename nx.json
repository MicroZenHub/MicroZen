{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ],
    "sharedGlobals": []
  },
  "defaultBase": "main",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "command": "dotnet format --verify-no-changes --verbosity=minimal",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/.editorconfig"],
      "cache": true
    }
  },
  "plugins": ["@nx/dotnet"],
  "affected": {
    "legacy": true
  }
}
