<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>MicroZen.Core.Api.Test</AssemblyName>
    <RootNamespace>MicroZen.Core.Api.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MicroZen.Api/MicroZen.Api.csproj" />
    <!--
      MicroZen.Api transitively pulls in MicroZen.OAuth2, and both assemblies generate the
      MicroZen.Grpc.V1 proto types from the same client.proto. Aliasing the OAuth2 reference
      keeps its copies out of the global namespace so proto message types (e.g.
      ManyClientsRequest) resolve unambiguously to MicroZen.Api in tests.
    -->
    <ProjectReference Include="../MicroZen.OAuth2/MicroZen.OAuth2.csproj" Aliases="oauth2" />
  </ItemGroup>

  <!--
    MicroZen.OAuth2 compiles the same client.proto as MicroZen.Api, so both
    assemblies define the MicroZen.Grpc.V1.* types (e.g. ClientType,
    ManyClientsRequest). The test project references MicroZen.Api directly and
    MicroZen.OAuth2 transitively, which makes those gRPC types ambiguous
    (CS0433). Alias the transitive MicroZen.OAuth2 assembly so its copies leave
    the global namespace and MicroZen.Grpc.V1.* resolves unambiguously to
    MicroZen.Api.
  -->
  <Target Name="AliasOAuth2GrpcTypes" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'MicroZen.OAuth2'">
        <Aliases>MicroZenOAuth2</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Security\Encryption\Attributes\" />
    <Folder Include="Security\Encryption\Converters\" />
    <Folder Include="Security\Encryption\Extensions\" />
    <Folder Include="Security\Encryption\Utils\" />
  </ItemGroup>

</Project>
