<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>MicroZen.Core.Api.Test</AssemblyName>
    <RootNamespace>MicroZen.Core.Api.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MicroZen.Api/MicroZen.Api.csproj" />
    <!--
      MicroZen.Api transitively pulls in MicroZen.Core, and both assemblies generate the
      MicroZen.Grpc.V1 proto types from the same client.proto. Aliasing the Core reference
      keeps its copies out of the global namespace so proto message types (e.g.
      ManyClientsRequest) resolve unambiguously to MicroZen.Api in tests.
    -->
    <ProjectReference Include="../MicroZen.Core/MicroZen.Core.csproj" Aliases="oauth2" />
  </ItemGroup>

  <!--
    MicroZen.Core compiles the same client.proto as MicroZen.Api, so both
    assemblies define the MicroZen.Grpc.V1.* types (e.g. ClientType,
    ManyClientsRequest). The test project references MicroZen.Api directly and
    MicroZen.Core transitively, which makes those gRPC types ambiguous
    (CS0433). Alias the transitive MicroZen.Core assembly so its copies leave
    the global namespace and MicroZen.Grpc.V1.* resolves unambiguously to
    MicroZen.Api.
  -->
  <Target Name="AliasCoreGrpcTypes" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'MicroZen.Core'">
        <Aliases>MicroZenCore</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Security\Encryption\Attributes\" />
    <Folder Include="Security\Encryption\Converters\" />
    <Folder Include="Security\Encryption\Extensions\" />
    <Folder Include="Security\Encryption\Utils\" />
  </ItemGroup>

</Project>
